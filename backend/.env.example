# Optional absolute paths. Defaults are under the backend/ directory.
DATAINSIGHT_DB_PATH=
DATAINSIGHT_DATA_DIR=
DATAINSIGHT_DATABASE_URL=

# OpenRouter credentials are backend-only. Never put OPENROUTER_API_KEY in the frontend.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_TIMEOUT_SECONDS=90

# Local RAG configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FASTEMBED_CACHE_PATH=storage/models
KNOWLEDGE_BASE_PATH=
CHROMA_PATH=storage/chroma
CHROMA_COLLECTION=datainsight_knowledge
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_TOOL_CALLS=5
MAX_MESSAGE_LENGTH=4000
CONVERSATION_TURN_LIMIT=20
AGENT_PREVIEW_ROW_LIMIT=8
AI_EAGER_INITIALIZE=true
AGENT_ADMIN_TOKEN=

# Comma-separated origins. The React/Vite development origins are enabled by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO